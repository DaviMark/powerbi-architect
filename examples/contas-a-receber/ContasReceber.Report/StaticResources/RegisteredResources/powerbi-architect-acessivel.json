{
  "name": "Power BI Architect",
  "dataColors": [
    "#3E63DD",
    "#00826D",
    "#D14E00",
    "#8145B5",
    "#AD6200",
    "#00749E"
  ],
  "foreground": "#333333",
  "foregroundNeutralSecondary": "#666666",
  "foregroundNeutralTertiary": "#757575",
  "background": "#FFFFFF",
  "backgroundLight": "#F9F9F9",
  "backgroundNeutral": "#EBEBEB",
  "tableAccent": "#3E63DD",
  "good": "#00824D",
  "neutral": "#757575",
  "bad": "#CE2C31",
  "maximum": "#3358D4",
  "center": "#ABBDF9",
  "minimum": "#E0E9FF",
  "null": "#D6D6D6",
  "hyperlink": "#3E63DD",
  "visitedHyperlink": "#5753C6",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "title": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#666666"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EBEBEB"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#757575"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#757575"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ],
        "legend": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F1F1"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F1F1F1"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "clusteredGapSize": 32
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "clusteredGapSize": 32
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": false
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#666666"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#333333"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F1F1F1"
              }
            },
            "rowPadding": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "textSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#757575"
              }
            }
          }
        ],
        "items": [
          {
            "textSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "orientation": 1,
            "cellPadding": 0
          }
        ],
        "shape": [
          {
            "tileShape": "rectangleRounded"
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#F1F1F1"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EBEBEB"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#E3E3E3"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#666666"
              }
            },
            "horizontalAlignment": "left",
            "leftMargin": 32
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            }
          },
          {
            "$id": "selected",
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#00824D"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#CE2C31"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    }
  }
}