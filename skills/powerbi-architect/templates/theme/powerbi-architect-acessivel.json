{
  "name": "Power BI Architect",
  "dataColors": [
    "#2F6FEB",
    "#EF5F00",
    "#C2298A",
    "#00A2C7",
    "#E93D82",
    "#8145B5"
  ],
  "foreground": "#1D1D1F",
  "foregroundNeutralSecondary": "#6E6E73",
  "foregroundNeutralTertiary": "#6E6E73",
  "background": "#FFFFFF",
  "backgroundLight": "#FAFAFA",
  "backgroundNeutral": "#E8E8ED",
  "tableAccent": "#2F6FEB",
  "good": "#00824D",
  "neutral": "#6E6E73",
  "bad": "#CE2C31",
  "maximum": "#2F6FEB",
  "center": "#A1BEF6",
  "minimum": "#E6EEFD",
  "null": "#D6D6D6",
  "hyperlink": "#2F6FEB",
  "visitedHyperlink": "#5753C6",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1F"
    },
    "title": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1F"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1F"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6E6E73"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#E8E8ED"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#86868B"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EDEDF0"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#86868B"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "legend": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#1D1D1F"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "clusteredGapSize": 32
          }
        ],
        "categoryAxis": [
          {
            "innerPadding": 55
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "clusteredGapSize": 32
          }
        ],
        "categoryAxis": [
          {
            "innerPadding": 40
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "rowPadding": 4
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "textSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "items": [
          {
            "textSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            }
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "orientation": 1,
            "cellPadding": 0
          }
        ],
        "shape": [
          {
            "tileShape": "rectangleRounded"
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#ECECF0"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#E5E5EA"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            },
            "horizontalAlignment": "left",
            "leftMargin": 32
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            }
          },
          {
            "$id": "selected",
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            }
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#2E9E6B"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#E5484D"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#8E8E93"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "innerPadding": 35
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "indicator": [
          {
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "horizontalAlignment": "left"
          }
        ],
        "goals": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            },
            "distanceFontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "status": [
          {
            "goodColor": {
              "solid": {
                "color": "#00824D"
              }
            },
            "badColor": {
              "solid": {
                "color": "#CE2C31"
              }
            },
            "neutralColor": {
              "solid": {
                "color": "#6E6E73"
              }
            }
          }
        ],
        "trendline": [
          {
            "show": true,
            "transparency": 85
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#6E6E73"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "rowPadding": 4
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "innerPadding": 45
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": true
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "gridlineShow": false
          }
        ]
      }
    }
  }
}
