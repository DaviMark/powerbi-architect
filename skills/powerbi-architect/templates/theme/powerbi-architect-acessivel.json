{
  "name": "Power BI Architect · Acessível",
  "dataColors": [
    "#1F4E79",
    "#B35900",
    "#00756A",
    "#7A3E9D",
    "#5C6670",
    "#8A6A00",
    "#4F7FA8",
    "#D98C3F",
    "#3FA394",
    "#A77BC2",
    "#9AA3AB",
    "#B8962E"
  ],
  "foreground": "#252423",
  "foregroundNeutralSecondary": "#605E5C",
  "foregroundNeutralTertiary": "#8A8886",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F2F1",
  "backgroundNeutral": "#C8C6C4",
  "tableAccent": "#1F4E79",
  "good": "#1A7F37",
  "neutral": "#5C6670",
  "bad": "#C62828",
  "maximum": "#1F4E79",
  "center": "#8FB0CC",
  "minimum": "#E8EEF4",
  "null": "#C8C6C4",
  "hyperlink": "#1F4E79",
  "visitedHyperlink": "#5B2C83",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#252423"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#252423"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#252423"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#605E5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "labels": [
          {
            "fontSize": 10
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F2F1"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#252423"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    }
  }
}