{
    "dataRoles": [
        {
            "displayName": "Period",
            "displayNameKey": "Role_Period",
            "name": "period",
            "kind": "Grouping"
        },
        {
            "displayName": "Value",
            "displayNameKey": "Role_Value",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Comparison (last year, plan)",
            "displayNameKey": "Role_Compare",
            "name": "compare",
            "kind": "Measure"
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_Tooltips",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "period": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "compare": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "period"
                    },
                    "dataReductionAlgorithm": {
                        "bottom": {
                            "count": 60
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "value"
                            }
                        },
                        {
                            "bind": {
                                "to": "compare"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "brand": {
            "properties": {
                "accent": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "text": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "secondary": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "context": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontFamily": {
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                }
            }
        },
        "header": {
            "properties": {
                "title": {
                    "type": {
                        "text": true
                    }
                },
                "showHeadline": {
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "focus": {
            "properties": {
                "highlight": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "last",
                                "displayName": "last"
                            },
                            {
                                "value": "max",
                                "displayName": "max"
                            },
                            {
                                "value": "none",
                                "displayName": "none"
                            }
                        ]
                    }
                }
            }
        }
    },
    "supportsHighlight": true,
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "privileges": [],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltips"
        ]
    }
}
