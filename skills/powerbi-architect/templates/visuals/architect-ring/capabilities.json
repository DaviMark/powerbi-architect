{
    "dataRoles": [
        {
            "displayName": "Slices (category)",
            "displayNameKey": "Role_Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Value",
            "displayNameKey": "Role_Value",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Target (goal mode)",
            "displayNameKey": "Role_Target",
            "name": "target",
            "kind": "Measure"
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_Tooltips",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "target": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 6
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "value"
                            }
                        },
                        {
                            "bind": {
                                "to": "target"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "brand": {
            "properties": {
                "accent": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "text": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "secondary": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "context": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontFamily": {
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                }
            }
        },
        "header": {
            "properties": {
                "title": {
                    "type": {
                        "text": true
                    }
                },
                "centerNote": {
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "ring": {
