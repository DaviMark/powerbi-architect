{
  "name": "Marca Âmbar",
  "dataColors": [
    "#FFB800",
    "#1F3A5F",
    "#4A90A4",
    "#8C6BB1",
    "#E4572E",
    "#6B7A8F",
    "#2E8B57",
    "#B8860B",
    "#A3B8CC",
    "#C9A227"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#FFB800",
  "foregroundNeutralSecondary": "#5F6B7A",
  "foregroundNeutralTertiary": "#9AA5B1",
  "backgroundLight": "#F4F5F7",
  "backgroundNeutral": "#E4E7EB",
  "good": "#00824D",
  "neutral": "#FFB800",
  "bad": "#CE2C31",
  "maximum": "#FFB800",
  "center": "#FFE08A",
  "minimum": "#FFF6D9",
  "hyperlink": "#1F3A5F",
  "visitedHyperlink": "#6B7A8F",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5F6B7A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6B7A"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E4E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6B7A"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#E4E7EB"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6B7A"
              }
            },
            "fontSize": 10,
            "position": "Top"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E4E7EB"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFF6D9"
              }
            },
            "outline": "BottomOnly",
            "outlineColor": {
              "solid": {
                "color": "#FFB800"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#1F2933"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontSize": 10
          }
        ]
      }
    }
  }
}