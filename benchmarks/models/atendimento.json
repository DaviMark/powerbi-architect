{
  "id": "bench-atendimento",
  "app": "Atendimento",
  "project": "Atendimento",
  "description": "Modelo do cenário de benchmark de atendimento ao cliente. Só o modelo é usado; o relatório é apagado.",
  "slicers": [],
  "tables": [
    {"name": "ft_chamados", "description": "Chamados de suporte abertos nos últimos 24 meses.", "grain": "1 linha por chamado", "source": "dw.vw_fato_chamados",
     "columns": [
       {"name": "id_equipe", "type": "int64", "hidden": true, "references": "dm_equipe"},
       {"name": "id_categoria", "type": "int64", "hidden": true, "references": "dm_categoria"},
       {"name": "Data Abertura", "type": "dateTime", "hidden": true, "format": "dd/mm/yyyy", "sql": "t.data_abertura", "references": "dm_calendario"},
       {"name": "Horas Resolucao", "type": "decimal", "hidden": true, "format": "#,0.0", "sql": "t.horas_resolucao", "description": "Horas úteis entre a abertura e a resolução; vazio enquanto aberto."},
       {"name": "Dentro SLA", "type": "int64", "hidden": true, "sql": "t.dentro_sla", "description": "1 quando resolvido dentro do prazo do SLA."},
       {"name": "Reaberto", "type": "int64", "hidden": true, "sql": "t.reaberto", "description": "1 quando o cliente reabriu o chamado."},
       {"name": "Nota CSAT", "type": "decimal", "hidden": true, "format": "0.0", "sql": "t.nota_csat", "description": "Nota de satisfação de 1 a 5; vazio quando o cliente não respondeu."}
     ]},
    {"name": "dm_equipe", "description": "Equipes de suporte.", "grain": "1 linha por equipe", "source": "dw.vw_dim_equipe",
     "columns": [
       {"name": "id_equipe", "type": "int64", "hidden": true, "key": true},
       {"name": "Equipe", "type": "string", "sql": "t.nome", "examples": ["N1 Varejo", "N1 Empresas", "N2 Técnico", "N2 Financeiro", "N3 Especialistas", "Plantão"]},
       {"name": "Nível", "type": "string", "sql": "t.nivel", "examples": ["N1", "N2", "N3"]}
     ]},
    {"name": "dm_categoria", "description": "Categorias de chamado.", "grain": "1 linha por categoria", "source": "dw.vw_dim_categoria_chamado",
     "columns": [
       {"name": "id_categoria", "type": "int64", "hidden": true, "key": true},
       {"name": "Categoria", "type": "string", "sql": "t.nome", "examples": ["Acesso", "Cobrança", "Instalação", "Lentidão", "Integração", "Dúvida"]},
       {"name": "Prioridade", "type": "string", "sql": "t.prioridade", "examples": ["Crítica", "Alta", "Média", "Baixa"]}
     ]}
  ],
  "measures": [
    {"name": "Chamados", "description": "Chamados abertos no período.", "expr": "COUNTROWS ( ft_chamados )", "format": "#,0", "folder": "Volume", "sample": "18.402"},
    {"name": "Chamados Resolvidos", "description": "Chamados com resolução registrada.", "expr": "CALCULATE ( [Chamados], NOT ISBLANK ( ft_chamados[Horas Resolucao] ) )", "format": "#,0", "folder": "Volume"},
    {"name": "% Dentro do SLA", "description": "Chamados resolvidos dentro do SLA sobre os resolvidos.", "expr": "DIVIDE ( SUM ( ft_chamados[Dentro SLA] ), [Chamados Resolvidos] )", "format": "0.0%", "folder": "Indicadores", "sample": "87,3%"},
    {"name": "Meta SLA", "description": "Meta de chamados dentro do SLA acordada em contrato.", "expr": "0.9", "format": "0%", "folder": "Metas"},
    {"name": "Tempo Médio de Resolução (h)", "description": "Média de horas úteis até a resolução.", "expr": "AVERAGE ( ft_chamados[Horas Resolucao] )", "format": "#,0.0", "folder": "Indicadores", "sample": "11,4"},
    {"name": "% Reabertos", "description": "Chamados reabertos pelo cliente sobre os resolvidos.", "expr": "DIVIDE ( SUM ( ft_chamados[Reaberto] ), [Chamados Resolvidos] )", "format": "0.0%", "folder": "Indicadores", "sample": "4,1%"},
    {"name": "CSAT", "description": "Nota média de satisfação, de 1 a 5, entre os clientes que responderam.", "expr": "AVERAGE ( ft_chamados[Nota CSAT] )", "format": "0.0", "folder": "Indicadores", "sample": "4,3"}
  ],
  "pages": [{"name": "Vazia", "icon": "layout-dashboard", "rows": []}]
}
