{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "linha_mensal",
  "position": {
    "x": 20,
    "y": 190,
    "z": 0,
    "width": 760,
    "height": 510,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dm_calendario"
                    }
                  },
                  "Property": "Ano-Mês"
                }
              },
              "queryRef": "dm_calendario.Ano-Mês",
              "nativeQueryRef": "Ano-Mês",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "% No Prazo"
                }
              },
              "queryRef": "_Medidas.% No Prazo",
              "nativeQueryRef": "% No Prazo"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "Meta % No Prazo"
                }
              },
              "queryRef": "_Medidas.Meta % No Prazo",
              "nativeQueryRef": "Meta % No Prazo"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'% no prazo por mês vs. meta'"
                }
              }
            }
          }
        }
      ]
    }
  }
}