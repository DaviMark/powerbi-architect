/// Medidas do relatório e data da última carga.
table _Medidas

	/// Saldo em aberto das parcelas, vencidas ou a vencer.
	measure 'Valor Aberto' = SUM ( ft_titulos[Valor Aberto] )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Saldo em aberto das parcelas com vencimento anterior à data da carga.
	measure 'Valor Vencido' = CALCULATE ( [Valor Aberto], ft_titulos[Dias Atraso] > 0 )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Parcela do saldo em aberto que já venceu.
	measure '% Vencido' = DIVIDE ( [Valor Vencido], [Valor Aberto] )
		formatString: 0.0%
		displayFolder: Indicadores

	/// Média de dias de atraso das parcelas vencidas, ponderada pelo saldo em aberto.
	measure 'Atraso Médio (dias)' =
			DIVIDE (
				SUMX (
					FILTER ( ft_titulos, ft_titulos[Dias Atraso] > 0 ),
					ft_titulos[Dias Atraso] * ft_titulos[Valor Aberto]
				),
				[Valor Vencido]
			)
		formatString: #,0
		displayFolder: Indicadores

	/// Valor vencido há mais de 90 dias: a parte do vencido mais difícil de receber.
	measure 'Vencido 90+' = CALCULATE ( [Valor Aberto], ft_titulos[Dias Atraso] > 90 )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Linha do KPI de vencido há mais de 90 dias: a parte que ele é do vencido.
	measure 'Texto Vencido 90+' = FORMAT ( DIVIDE ( [Vencido 90+], [Valor Vencido] ), "0%" ) & " do vencido"
		displayFolder: Textos

	/// Valor vencido no mesmo período do ano anterior, para comparar na tendência.
	measure 'Vencido Ano Anterior' = CALCULATE ( [Valor Vencido], SAMEPERIODLASTYEAR ( dm_calendario[Data] ) )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Saldo em aberto das parcelas que ainda não venceram.
	measure 'Valor a Vencer' = [Valor Aberto] - [Valor Vencido]
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Quantidade de clientes com pelo menos uma parcela vencida.
	measure 'Clientes Vencidos' = CALCULATE ( DISTINCTCOUNT ( ft_titulos[id_cliente] ), ft_titulos[Dias Atraso] > 0 )
		formatString: #,0
		displayFolder: Indicadores

	/// Meta da diretoria para a parcela vencida do saldo.
	measure 'Meta % Vencido' = 0.15
		formatString: 0%
		displayFolder: Metas

	/// Meta da diretoria para o atraso médio, em dias.
	measure 'Meta Dias Atraso' = 30
		formatString: #,0
		displayFolder: Metas

	/// Linha de contexto do KPI de saldo: quanto ainda não venceu.
	measure 'Texto A Vencer' = FORMAT ( [Valor a Vencer], "R$ #,0" ) & " ainda a vencer"
		displayFolder: Textos

	/// Linha de contexto do KPI de vencido: quantos clientes estão em atraso.
	measure 'Texto Clientes Vencidos' = FORMAT ( [Clientes Vencidos], "#,0" ) & " clientes em atraso"
		displayFolder: Textos

	/// Distância do % vencido para a meta, em pontos percentuais, com seta.
	measure 'Texto Var % Vencido' = VAR _d = [% Vencido] - [Meta % Vencido] RETURN IF ( ISBLANK ( [% Vencido] ), BLANK (), IF ( _d > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ) * 100, "0.0" ) & " p.p. " & IF ( _d > 0, "acima", "abaixo" ) & " da meta de " & FORMAT ( [Meta % Vencido], "0%" ) )
		displayFolder: Textos

	/// Cor da linha de meta do % vencido: vermelho acima da meta, verde abaixo.
	measure 'Cor Var % Vencido' = IF ( [% Vencido] > [Meta % Vencido], "#CE2C31", "#00824D" )
		displayFolder: Cores

	/// Distância do atraso médio para a meta, em dias, com seta.
	measure 'Texto Var Dias Atraso' = VAR _d = [Atraso Médio (dias)] - [Meta Dias Atraso] RETURN IF ( ISBLANK ( [Atraso Médio (dias)] ), BLANK (), IF ( _d > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "#,0" ) & " dias " & IF ( _d > 0, "acima", "abaixo" ) & " da meta de " & FORMAT ( [Meta Dias Atraso], "#,0" ) )
		displayFolder: Textos

	/// Cor da linha de meta do atraso médio: vermelho acima da meta, verde abaixo.
	measure 'Cor Var Dias Atraso' = IF ( [Atraso Médio (dias)] > [Meta Dias Atraso], "#CE2C31", "#00824D" )
		displayFolder: Cores

	/// Cor do % vencido em tabelas: vermelho quando passa da meta.
	measure 'Cor % Vencido' = IF ( [% Vencido] > [Meta % Vencido], "#CE2C31", "#333333" )
		displayFolder: Cores

	/// Data e hora da última carga, para a barra do topo.
	measure 'Texto Atualizacao' = "Atualizado em " & FORMAT ( MAX ( '_Medidas'[Data Carga] ), "dd/mm/yyyy hh:nn" )
		displayFolder: Títulos

	/// Título dinâmico da página Visão Geral: valor vencido e participação no saldo.
	measure 'Titulo Vencido' = "Vencido: " & FORMAT ( [Valor Vencido], "R$ #,0" ) & " (" & FORMAT ( [% Vencido], "0.0%" ) & " do saldo)"
		displayFolder: Títulos

	/// Situação do cliente para listas de cobrança: Atrasado acima de 60 dias, Em risco acima de 30, Em dia sem parcela vencida.
	measure Situação = SWITCH ( TRUE (), ISBLANK ( [Valor Aberto] ), BLANK (), [Atraso Médio (dias)] > 60, "Atrasado", [Atraso Médio (dias)] > 30, "Em risco", [Valor Vencido] > 0, "A vencer", "Em dia" )
		displayFolder: Textos

	column 'Data Carga'
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy hh:nn
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Data Carga]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "Data Carga", UTCNOW () - 3 / 24 )
