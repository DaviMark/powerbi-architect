{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/1.0.0/schema.json",
  "layoutOptimization": "None",
  "settings": {
    "useStylableVisualContainerHeader": true,
    "exportDataMode": "AllowSummarized",
    "defaultDrillFilterOtherVisuals": true,
    "allowChangeFilterTypes": true,
    "useEnhancedTooltips": true
  },
  "themeCollection": {
    "customTheme": {
      "name": "powerbi-architect-acessivel.json",
      "reportVersionAtImport": "5.59",
      "type": "RegisteredResources"
    }
  },
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "powerbi-architect-acessivel.json",
          "path": "powerbi-architect-acessivel.json",
          "type": "CustomTheme"
        },
        {
          "name": "chart-bar.png",
          "path": "chart-bar.png",
          "type": "Image"
        },
        {
          "name": "file-description.png",
          "path": "file-description.png",
          "type": "Image"
        },
        {
          "name": "layout-dashboard.png",
          "path": "layout-dashboard.png",
          "type": "Image"
        }
      ]
    }
  ]
}
